# Documentation only: Node does not automatically read this file.
# Set variables in your terminal, or use node --env-file=.env server/main.mjs.
CODEX_POCKET_HOST=127.0.0.1
CODEX_POCKET_PORT=8787
# Set CODEX_POCKET_CWD to a dedicated existing project/workspace directory.
# CODEX_POCKET_CWD=C:/Projects/MyWorkspace
# Remote proxy control stays disabled unless the PC owner explicitly opts in.
CODEX_POCKET_ALLOW_PROXY_CONTROL=0
